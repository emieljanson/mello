# Track lists (the list button on a cover) need your own Spotify app key.
# Two minutes at https://developer.spotify.com/dashboard — create an app, any
# name, redirect URI http://127.0.0.1:8080 (unused, but the form demands one),
# then copy the two values here.
# Without them Mello borrows go-librespot's token, whose client ID is shared by
# every librespot install worldwide; that quota is permanently exhausted and
# every track list request comes back 429. See docs/spotify-api.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Playlists need one more thing: Spotify requires the playlist-read-private
# scope to read a playlist's tracks — every playlist, public ones included —
# and the key above carries no scopes at all. Albums and shows are unaffected.
# Run `python3 mello-login.py` once; it fills this in for you.
SPOTIFY_REFRESH_TOKEN=

# Only needed if adding a podcast logs a 404: episode availability is
# market-scoped and an app token carries no country. Two-letter code, e.g. FR.
SPOTIFY_MARKET=

# Anonymous usage data sharing is configured during install (setup.sh).
# The setting is stored in data/settings.json and cannot be changed via the UI.
#
# To send analytics to your own PostHog project instead, set your key here:
# POSTHOG_API_KEY=phc_your_key_here
# POSTHOG_HOST=https://us.i.posthog.com

# Keep this fixed if you want one stable device in PostHog.
# Example: ANALYTICS_DISTINCT_ID=mello-livingroom
ANALYTICS_DISTINCT_ID=

# Privacy defaults are strict; keep these off unless you need detail.
ANALYTICS_INCLUDE_CONTENT=0
# For multiple Pi devices, set this to 1 to keep each Pi unique.
ANALYTICS_USE_MACHINE_ID=1
