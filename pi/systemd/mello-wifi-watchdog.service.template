[Unit]
Description=Mello WiFi watchdog (pi/wifi-watchdog.sh): back online without the app
After=NetworkManager.service
# A speaker held on an older version (no Slint) has no such script: do nothing.
ConditionPathExists=__HOME__/mello/pi/wifi-watchdog.sh

[Service]
Type=oneshot
# Root: it manages NetworkManager and stops the root-owned wifi-connect.
ExecStart=/bin/bash __HOME__/mello/pi/wifi-watchdog.sh
StandardOutput=journal
TimeoutStartSec=3min
